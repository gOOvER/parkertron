# Parkertron Docker Environment Configuration
# Copy this file to .env and fill in your values

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Enable/Disable services
DISCORD_ENABLED=true
IRC_ENABLED=false
SLACK_ENABLED=false

# Optional: Database configuration (for future use)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=parkertron
# DB_USER=parkertron
# DB_PASSWORD=changeme

# Optional: Webhook configuration
# WEBHOOK_LOG_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Container resource limits (optional)
# MEMORY_LIMIT=512M
# CPU_LIMIT=0.5
